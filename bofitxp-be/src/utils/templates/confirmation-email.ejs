<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BoFitXP - Email Confirmation</title>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
      }

      .container {
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 8px;
        overflow: hidden;
      }

      .header {
        background-color: #6c3fff;
        padding: 20px;
        color: #ffffff;
        text-align: center;
      }

      .header h1 {
        margin: 0;
        font-size: 26px;
      }

      .content {
        padding: 24px;
        color: #333333;
        line-height: 1.6;
      }

      .otp-container {
        margin: 28px 0;
        text-align: center;
      }

      .otp-label {
        margin-bottom: 12px;
        font-size: 14px;
        color: #666666;
      }

      .otp-code {
        display: inline-block;
        padding: 16px 24px;
        border-radius: 10px;
        background-color: #6c3fff;
        color: #ffffff;
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 8px;
        text-align: center;
      }

      .account-info {
        padding: 16px;
        background-color: #f8f6ff;
        border-radius: 8px;
        margin: 20px 0;
      }

      .account-info p {
        margin: 8px 0;
        font-size: 14px;
        overflow-wrap: anywhere;
      }

      .notice {
        padding: 12px 16px;
        background-color: #fff8e6;
        border-left: 4px solid #ffc107;
        border-radius: 4px;
        font-size: 13px;
      }

      .footer {
        background-color: #f1f1f1;
        padding: 16px;
        text-align: center;
        font-size: 12px;
        color: #666666;
      }

      .footer p {
        margin: 4px 0;
      }

      @media (max-width: 600px) {
        .container {
          margin: 0;
          border-radius: 0;
          width: auto;
        }

        .content {
          padding: 20px;
        }

        .otp-code {
          font-size: 28px;
          letter-spacing: 5px;
          padding: 14px 18px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Confirm Your Email</h1>
      </div>

      <div class="content">
        <p>Hi <%= username %>,</p>

        <p>
          Thank you for being part of BoFitXP! To confirm your email address and
          continue using your account, please enter the One-Time Password (OTP)
          below.
        </p>

        <div class="otp-container">
          <p class="otp-label">Your confirmation code</p>
          <div class="otp-code"><%= otpConfirmationCode %></div>
        </div>

        <p>
          Enter this code in the BoFitXP application to complete your email
          confirmation process.
        </p>

        <div class="account-info">
          <p><strong>Account Information</strong></p>
          <p><strong>Name:</strong> <%= fullName %></p>
          <p><strong>Username:</strong> <%= username %></p>
          <p><strong>Email:</strong> <%= email %></p>
          <!-- <p><strong>Registered On:</strong> <%= createdAt %></p> -->
        </div>

        <div class="notice">
          <strong>Security Reminder</strong>
          <p>
            This is only valid for 5 minutes. Never share this OTP with anyone,
            including people claiming to represent BoFitXP. If you did not
            request this confirmation code, you can safely ignore this email.
          </p>
        </div>

        <p>If you need assistance, please contact our support team.</p>

        <p>
          Best regards,<br />
          <strong>BoFitXP Team</strong>
        </p>
      </div>

      <div class="footer">
        <p>&copy; 2026 BoFitXP. All Rights Reserved.</p>
        <p>Level up your life, one quest at a time.</p>
      </div>
    </div>
  </body>
</html>
